# ---------------------------------------------------------------------------
# pdf2word - what is NOT committed.
# The repository carries everything needed to develop on another PC: sources,
# tests, docs and notes (*.md anywhere), uv.lock, .python-version, the launcher
# and shared editor / Claude Code settings.  Only generated files, per-machine
# state, secrets and copyrighted PDFs / conversion results stay local.
# ---------------------------------------------------------------------------

# Python / packaging (generated)
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# virtual environments (main_gui.bat recreates them; or `uv venv` + `uv pip install -e .`)
.venv/
venv/
env/

# per-machine state of editors and tools (shared settings stay in the repo)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
.obsidian/workspace*.json
.obsidian/cache
.claude/settings.local.json
.claude/*.local.*

# secrets (API keys etc.)
.env
.env.*
*.key

# logs, scratch, local backups, OS clutter
*.log
*.tmp
.pdf2word-tmp/
backup/
desktop.ini
Thumbs.db
.DS_Store

# papers and conversion results must never be committed (copyrighted content).
# Convert into a folder outside the repository or into out/ below.
*.pdf
*.docx
~$*.docx
_asset-*/
out/
output/
# small synthetic fixtures for the tests are allowed
!tests/**/*.pdf

# equation OCR benchmarks (tools/bench_mathocr.py): one folder per PDF under bench/.
# Only the hand-made golden set is kept; reports, results and crops are generated.
bench/**
!bench/*/
!bench/*/golden.json
